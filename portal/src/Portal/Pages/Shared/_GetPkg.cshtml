@using Microsoft.Extensions.Options
@using Portal.Channels
@model ChannelInfo
@inject IOptions<PortalOptions> Options
@{
    var dir = System.IO.Path.Combine(Options.Value.ChannelsDir, Model.Name);
    var cpus = Bootstrap.ArosCpus(dir);
    var host = (Options.Value.PublicUrl.Length > 0 ? Options.Value.PublicUrl.TrimEnd('/') : $"{Context.Request.Scheme}://{Context.Request.Host}");
    var plain = "http://" + host[(host.IndexOf("://", StringComparison.Ordinal) + 3)..];
    var getpkg = $"wget -q -O RAM:Get-Pkg {plain}/Get-Pkg\nExecute RAM:Get-Pkg";
    var hosts = ChannelPaths.HostBootstraps.Where(h => System.IO.File.Exists(System.IO.Path.Combine(dir, h.Value))).ToList();
}
<details class="getpkg" open data-remember="getpkg-folded">
    <summary>
        <span class="when-open"><span class="getpkg-title">One line, and Pkg installs itself</span><span class="fold">I have it already, hide this</span></span>
        <span class="when-folded">Need Pkg? Show how to get it</span>
    </summary>
    <p>Pick the machine you are on.</p>
    <div class="grid">
        <div>
            <h3>On AROS</h3>
            @if (cpus.Count == 0)
            {
                <p class="muted">No AROS build is published in this channel yet.</p>
            }
            else
            {
                <p><strong>With a network and <code>wget</code></strong> (AROS One, Icaros, the nightly with contrib), paste these two lines in a Shell:</p>
                <div class="cmd lines"><code>@getpkg</code><button class="copy" data-copy="@getpkg">Copy</button></div>
                <p class="muted small">A <code>wget</code> that ends at once without a word wants its settings file first: <code>Echo "" &gt;ENV:wgetcfg</code></p>
                <p><strong>On Macaros or another hosted AROS</strong>, run the macOS and Linux line on the right: it also puts the drawer in the folder AROS shares and prints the one line to paste in the AROS Shell.</p>
                <p><strong>Without a network</strong>, download the drawer for your CPU, unzip it on the computer next to the AROS machine and copy the <code>Pkg-&lt;cpu&gt;</code> drawer across (a stick, a shared folder, a disk image). Then, in a Shell:</p>
                <div class="cmd"><code>Execute Pkg-x86_64/Install-Pkg Pkg-x86_64</code><button class="copy" data-copy="Execute Pkg-x86_64/Install-Pkg Pkg-x86_64">Copy</button></div>
                <p class="muted small">Either way the bare program installs the signed pkg package through its own checks, and from then on Pkg updates itself like any package: <code>Pkg UPGRADE pkg ROOT SYS: CHANNEL @plain/@Model.Name</code>.</p>
                <p class="buttons">
                    @foreach (var cpu in cpus)
                    {
                        <a class="button" href="/get/@Model.Name/pkg-@(cpu).zip">Pkg for @cpu (.zip)</a>
                    }
                </p>
                <details>
                    <summary class="small">Or the files one by one, for a browser on AROS</summary>
                    <p class="muted small">Keep the layout: each file goes to the same path under one drawer, and <code>index</code> lists only the version for your CPU.</p>
                    @foreach (var cpu in cpus)
                    {
                        <h3 class="small">@cpu</h3>
                        <table class="list mono">
                            <tbody>
                            @foreach (var f in Bootstrap.DrawerFiles(Model, dir, cpu).Select(r => Bootstrap.Offer(dir, r)))
                            {
                                <tr><td><a href="/@Model.Name/@f.Path">@f.Path</a></td><td class="num">@Site.Size(f.Size)</td><td class="hide-s" title="SHA-256 @f.Sha256">@Site.Short(f.Sha256)</td></tr>
                            }
                            </tbody>
                        </table>
                    }
                </details>
            }
        </div>
        <div>
            <h3>On macOS, Linux or Windows</h3>
            <p>To manage a hosted AROS, a disk image or a drawer from your computer.</p>
            @if (hosts.Count == 0)
            {
                <p class="muted">Host builds come with the next Pkg upload.</p>
            }
            else
            {
                var sh = $"curl -fsSL {host}/install | sh";
                var ps = $"irm {host}/install.ps1 | iex";
                <p class="small"><strong>macOS and Linux</strong>, in a terminal:</p>
                <div class="cmd wrapcode"><code>@sh</code><button class="copy" data-copy="@sh">Copy</button></div>
                <p class="small"><strong>Windows</strong>, in PowerShell:</p>
                <div class="cmd wrapcode"><code>@ps</code><button class="copy" data-copy="@ps">Copy</button></div>
                <p class="muted small">Each picks the build for your computer, checks that it runs, and puts <code>pkg</code> where you can run it by name, adding that folder to your PATH if needed. Run it again to upgrade. Read them first: <a href="/install.sh">install.sh</a>, <a href="/install.ps1">install.ps1</a>.</p>
                <details>
                    <summary class="small">Or download a build yourself</summary>
                    @foreach (var (platform, rel) in hosts)
                    {
                        var cmd = platform.StartsWith("windows")
                            ? $"Invoke-WebRequest {host}/get/{Model.Name}/{platform} -OutFile pkg.exe"
                            : $"curl -fsSLo pkg {host}/get/{Model.Name}/{platform} && chmod +x pkg && sudo mv pkg /usr/local/bin/";
                        var f = Bootstrap.Offer(dir, rel);
                        <p class="small muted">@platform · @Site.Size(f.Size) · <span title="SHA-256 @f.Sha256">SHA-256 @Site.Short(f.Sha256)</span></p>
                        <div class="cmd"><code>@cmd</code><button class="copy" data-copy="@cmd">Copy</button></div>
                        @if (platform.StartsWith("windows"))
                        {
                            <p class="muted small">Then move <code>pkg.exe</code> into a folder on your Path.</p>
                        }
                    }
                </details>
            }
        </div>
    </div>
</details>
