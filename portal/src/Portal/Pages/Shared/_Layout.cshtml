@using Microsoft.Extensions.Options
@inject Portal.Channels.Catalogue Catalogue
@inject IOptions<PortalOptions> Options
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="color-scheme" content="light dark" />
    <title>@(ViewData["Title"] is string t ? t + " · " : "")AROS Packages</title>
    <script src="~/js/theme.js" asp-append-version="true"></script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/atom+xml" title="New versions" href="/feed" />
    <link rel="icon" href="~/favicon.ico" sizes="16x16 32x32 48x48" />
</head>
<body>
<header class="top">
    <div class="wrap top-row">
        <a class="brand" href="/"><span class="mark" aria-hidden="true"></span>AROS Packages</a>
        @{ var here = Context.Request.Path.Value ?? "/"; string On(string p) => (p == "/search" ? here.StartsWith("/packages") || here.StartsWith("/search") : here.StartsWith(p)) ? "on" : ""; }
        <nav class="nav" aria-label="Main">
            <a class="@On("/search")" href="/search">Packages</a>
            <a class="@On("/channels")" href="/channels">Channels</a>
            <a class="@On("/downloads")" href="/downloads">Downloads</a>
            <a class="@(here.StartsWith("/publishers") ? "on" : "")" href="/publishers">Publishers</a>
            <a class="@On("/statistics")" href="/statistics">Statistics</a>
            <a class="@On("/trust")" href="/trust">Trust</a>
            <a class="@On("/docs")" href="/docs">Documentation</a>
            <a class="@On("/developer")" href="/developer">Developer</a>
        </nav>
        <form class="search" action="/search" method="get" role="search" hidden="@(here == "/")">
            <input type="search" name="q" value="@Context.Request.Query["q"]" placeholder="Search packages" aria-label="Search packages" />
        </form>
        <div class="tools">
            @{
                var login = User.Identity?.IsAuthenticated == true ? User.Identity.Name ?? "" : null;
                var maintainer = login is not null && Options.Value.Admins.Split(';', ',').Any(a => string.Equals(a.Trim(), login, StringComparison.OrdinalIgnoreCase));
            }
            @if (login is null)
            {
                <span class="theme" role="group" aria-label="Theme"><partial name="_ThemeButtons" /></span>
                if (Options.Value.GitHub.On)
                {
                    <a class="who out" href="/account">Sign in</a>
                }
            }
            else
            {
                <details class="menu">
                    <summary class="who" title="Your account"><span class="avatar" aria-hidden="true">@(login.Length > 0 ? login[..1] : "?")</span>@login@if (maintainer) { <span class="chip">maintainer</span> }</summary>
                    <div class="menu-body">
                        <p class="who-name">Signed in with GitHub as @login</p>
                        <a href="/account">Your publisher account</a>
                        @if (maintainer)
                        {
                            <a href="/admin">Maintainers</a>
                        }
                        <hr />
                        <div class="menu-row"><span>Theme</span><span class="theme" role="group" aria-label="Theme"><partial name="_ThemeButtons" /></span></div>
                        <hr />
                        <form method="post" action="/signout"><button type="submit">Sign out</button></form>
                    </div>
                </details>
            }
        </div>
    </div>
</header>
<main class="wrap">
    @if (Catalogue.SeesUnlisted())
    {
        <p class="muted small">You see unlisted channels too in this browser. <a href="/see/off">Stop</a></p>
    }
    @RenderBody()
</main>
<footer class="foot">
    <p>AROS Packages · Every package is signed, and pkg checks it before it installs. Totals only, no tracking.</p>
    <p><a href="/trust">Trust</a> · <a href="/docs">Documentation</a> · <a href="/publishers#publish">Publish here</a> · <a href="/account">Your account</a> · <a href="/developer">Developer</a> · <a href="/privacy">Privacy</a> · <a href="https://github.com/jonx/aros-pkg" rel="noopener">Source</a> · <a href="https://github.com/jonx/aros-pkg/issues" rel="noopener">Report an issue</a></p>
    <p class="build">@Portal.BuildInfo.Line · Preview, unlisted</p>
</footer>
<script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>
