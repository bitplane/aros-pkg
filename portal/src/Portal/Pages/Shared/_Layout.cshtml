@using Microsoft.Extensions.Options
@inject Portal.Channels.Catalogue Catalogue
@inject IOptions<PortalOptions> Options
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="color-scheme" content="light dark" />
    <title>@(ViewData["Title"] is string t ? t + " · " : "")AROS Packages</title>
    <script src="~/js/theme.js" asp-append-version="true"></script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/atom+xml" title="New versions" href="/feed" />
    <link rel="icon" href="~/favicon.ico" sizes="16x16 32x32 48x48" />
</head>
<body>
<header class="top">
    <div class="wrap top-row">
        <a class="brand" href="/"><span class="mark" aria-hidden="true"></span>AROS Packages</a>
        @{ var here = Context.Request.Path.Value ?? "/"; string On(string p) => (p == "/search" ? here.StartsWith("/channels") || here.StartsWith("/packages") || here.StartsWith("/search") : here.StartsWith(p)) ? "on" : ""; }
        <nav class="nav" aria-label="Main">
            <a class="@On("/search")" href="/search">Packages</a>
            <a class="@On("/downloads")" href="/downloads">Downloads</a>
            <a class="@(here.StartsWith("/publishers") ? "on" : "")" href="/publishers">Publishers</a>
            <a class="@On("/statistics")" href="/statistics">Statistics</a>
            <a class="@On("/trust")" href="/trust">Trust</a>
            <a class="@On("/docs")" href="/docs">Documentation</a>
        </nav>
        <form class="search" action="/search" method="get" role="search" hidden="@(here == "/")">
            <input type="search" name="q" value="@Context.Request.Query["q"]" placeholder="Search packages" aria-label="Search packages" />
        </form>
        <div class="tools">
            <span class="theme" role="group" aria-label="Theme">
                <button type="button" data-theme="light" title="Light" aria-label="Light theme"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg></button>
                <button type="button" data-theme="system" title="As the system" aria-label="Theme of the system"><svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="12" rx="2"/><path d="M8 20h8M12 16v4"/></svg></button>
                <button type="button" data-theme="dark" title="Dark" aria-label="Dark theme"><svg viewBox="0 0 24 24"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"/></svg></button>
            </span>
            @if (Options.Value.GitHub.On)
            {
                if (User.Identity?.IsAuthenticated == true)
                {
                    var login = User.Identity.Name ?? "";
                    var maintainer = Options.Value.Admins.Split(';', ',').Any(a => string.Equals(a.Trim(), login, StringComparison.OrdinalIgnoreCase));
                    <a class="who" href="@(maintainer ? "/admin" : "/account")" title="Signed in with GitHub"><span class="avatar" aria-hidden="true">@(login.Length > 0 ? login[..1] : "?")</span>@login@if (maintainer) { <span class="chip">maintainer</span> }</a>
                }
                else
                {
                    <a class="who out" href="/account" title="Sign in with GitHub to publish">Sign in</a>
                }
            }
        </div>
    </div>
</header>
<main class="wrap">
    @if (Catalogue.SeesUnlisted())
    {
        <p class="muted small">You see unlisted channels too in this browser. <a href="/see/off">Stop</a></p>
    }
    @RenderBody()
</main>
<footer class="wrap foot">
    <p>AROS Packages · Every package is signed, and Pkg checks it before it installs. Totals only, no tracking.</p>
    <p><a href="/trust">Trust</a> · <a href="/docs">Documentation</a> · <a href="/publishers#publish">Publish here</a> · <a href="/account">Your account</a> · <a href="/api">API and feeds</a> · <a href="https://github.com/jonx/aros-pkg" rel="noopener">Source</a> · <a href="https://github.com/jonx/aros-pkg/issues" rel="noopener">Report an issue</a></p>
    <p class="build">@Portal.BuildInfo.Line · Preview, unlisted</p>
</footer>
<script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>
