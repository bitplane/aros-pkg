<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="color-scheme" content="light dark" />
    <title>@(ViewData["Title"] is string t ? t + " · " : "")AROS Packages</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="icon" href="~/favicon.ico" />
</head>
<body>
<header class="top">
    <div class="wrap top-row">
        <a class="brand" href="/"><span class="mark" aria-hidden="true">▲</span> AROS Packages</a>
        <form class="search" action="/search" method="get" role="search">
            <input type="search" name="q" value="@Context.Request.Query["q"]" placeholder="Search packages" aria-label="Search packages" />
        </form>
    </div>
</header>
<main class="wrap">
    @RenderBody()
</main>
<footer class="wrap foot">
    <p>Preview, unlisted. Every package is signed with Ed25519, and Pkg checks each file against its signed manifest before installing it.
       <a href="/about">How this works</a></p>
</footer>
<script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>
