@page "/channels/{name}"
@using Microsoft.Extensions.Options
@using Portal.Channels
@inject Catalogue Catalogue
@inject Search Search
@inject IOptions<PortalOptions> Options
@{
    var name = (string)RouteData.Values["name"]!;
    var ch = Catalogue.Get(name);
    if (ch is null) { Response.StatusCode = 404; ViewData["Title"] = "No such channel"; }
    else ViewData["Title"] = ch.Name;
    string kind = Request.Query["kind"].ToString(), q = Request.Query["q"].ToString().Trim();
}
@if (ch is null)
{
    <h1>No channel named “@name”</h1>
    <p><a href="/channels">See every channel</a>.</p>
    return;
}
@{
    var url = Site.ChannelUrl(Request, Options.Value, ch.Name);
    bool Matches(PackageInfo p) => q.Length == 0
        || p.Name.Contains(q, StringComparison.OrdinalIgnoreCase)
        || (p.Latest.Manifest.Short ?? "").Contains(q, StringComparison.OrdinalIgnoreCase)
        || p.Latest.Manifest.Tags.Any(t => t.Contains(q, StringComparison.OrdinalIgnoreCase))
        || p.Latest.Manifest.Provides.Any(l => l.Contains(q, StringComparison.OrdinalIgnoreCase));
    var packages = ch.Packages.Values.Where(p => (kind.Length == 0 || p.Kind == kind) && Matches(p))
        .OrderBy(p => Catalogue.IsPinned(p) ? 0 : 1).ToList();
    var builds = ch.Builds().Take(10).ToList();
    var bytes = ch.Packages.Values.Sum(p => p.Latest.Manifest.InstalledSize);
    var archs = ch.Packages.Values.SelectMany(p => p.Archs).Distinct().Order().ToList();
}
<p class="crumbs"><a href="/channels">Channels</a></p>
<h1>@ch.Name</h1>
@if (Catalogue.IsUnlisted(ch.Name))
{
    <p class="muted">This channel is unlisted: it is served to whoever has this address and shown nowhere else on the site.</p>
}
<div class="stats">
    <div><strong>@ch.Packages.Count</strong><span>packages</span></div>
    <div><strong>@ch.Lines.Count</strong><span>versions published</span></div>
    <div><strong>@Site.Size(bytes)</strong><span>installed, latest versions</span></div>
    <div><strong>@string.Join(", ", archs.Select(Site.ArchLabel))</strong><span>CPUs</span></div>
</div>

<p class="small"><a href="/channels/@ch.Name/feed">Feed of new versions</a> (Atom) · <a href="/api/search?channel=@ch.Name">as JSON</a></p>
<h2 class="label">Use this channel</h2>
<div class="cmd"><code>Pkg CHANNEL ADD @url ROOT SYS:</code><button class="copy" data-copy="Pkg CHANNEL ADD @url ROOT SYS:">Copy</button></div>
<p class="muted small">Once, and the machine keeps it: <code>INSTALL</code>, <code>UPGRADE</code>, <code>STATUS</code>, <code>SHOW</code>, <code>SEARCH</code>, <code>REPAIR</code>, <code>ROLLBACK</code> and <code>RESOLVE</code> then read this channel without being told, together with the others the machine knows, in the order they were added. <a href="/docs/commands/channel">CHANNEL</a> lists and removes them.</p>
<div class="cmd"><code>Pkg STATUS ROOT SYS: CHANNEL @url</code><button class="copy" data-copy="Pkg STATUS ROOT SYS: CHANNEL @url">Copy</button></div>
<p class="muted small">Or name the address on the line, for this command alone. pkg reads it on AROS as on a Mac or a PC, and what you install is proven by its signature, not by the connection.</p>

@if (builds.Count > 0)
{
    <h2 class="label">Builds</h2>
    <table class="list">
        <thead><tr><th>Build</th><th>Published</th><th class="hide-s">New packages</th><th>Unchanged</th><th class="hide-s">Files</th><th class="hide-s">Installed size</th></tr></thead>
        <tbody>
        @foreach (var b in builds)
        {
            <tr>
                <td>@Site.BuildLabel(b.Build)</td>
                <td>@b.Published</td>
                <td class="hide-s">@b.NewPackages</td>
                <td>@b.Unchanged <span class="muted small">not republished</span></td>
                <td class="hide-s">@b.Files</td>
                <td class="hide-s">@Site.Size(b.InstalledBytes)</td>
            </tr>
        }
        </tbody>
    </table>
}

<h2 class="label">Packages</h2>
<form class="filters" method="get" role="search">
    <label>In this channel
        <input type="search" name="q" value="@q" placeholder="Search @ch.Name" aria-label="Search this channel" />
    </label>
    <label>Kind
        <select name="kind" data-autosubmit>
            <option value="">any</option>
            @foreach (var k in ch.Packages.Values.Select(p => p.Kind).Distinct().Order())
            {
                <option value="@k" selected="@(k == kind)">@Site.KindLabel(k)</option>
            }
        </select>
    </label>
    <button type="submit">Search</button>
    @if (q.Length > 0 || kind.Length > 0)
    {
        <a class="muted" href="/channels/@ch.Name">clear</a>
    }
</form>
<p class="muted small">@packages.Count of @ch.Packages.Count package@(ch.Packages.Count == 1 ? "" : "s")@(q.Length > 0 ? $" for “{q}”" : ""). This address holds the search, so it can be sent to someone.</p>
<table class="list">
    <thead><tr><th>Package</th><th>Version</th><th class="hide-s">Kind</th><th class="hide-s">CPU</th><th class="num">Size</th><th class="num hide-s">Downloads</th></tr></thead>
    <tbody>
    @foreach (var p in packages)
    {
        <tr class="@(p.Latest.Withdrawn ? "withdrawn" : "")">
            <td>
                <a href="/packages/@ch.Name/@p.Name">@Site.Mark(p.Name, q)</a>
                @if (Catalogue.IsPinned(p))
                {
                    <span class="pin">pinned</span>
                }
                @if (p.Latest.Manifest.Short is { } sh)
                {
                    <div class="muted small">@Site.Mark(sh, q)</div>
                }
            </td>
            <td><code>@p.Latest.Version</code></td>
            <td class="hide-s">@Site.KindLabel(p.Kind)</td>
            <td class="hide-s">@string.Join(", ", p.Archs.Select(Site.ArchLabel))</td>
            <td class="num">@Site.Size(p.Latest.Manifest.InstalledSize)</td>
            <td class="num hide-s">@(p.Latest.Manifest.Payload is null ? "-" : Search.DownloadsOf(p).ToString("N0"))</td>
        </tr>
    }
    </tbody>
</table>

@if (ch.Archives.Count > 0 || ch.Upstream.Count > 0)
{
    <h2 class="label">Source archives</h2>
    <p class="muted small">Packages whose files stay inside a published archive, such as a nightly contrib build. pkg takes each package's files out and checks them one by one.</p>
    <ul class="plain">
    @foreach (var a in ch.Archives)
    {
        <li><a href="/@ch.Name/archives/@a">@a</a> <span class="muted small">· @Site.ArchiveStatus(ch, a)</span></li>
    }
    @foreach (var (a, up) in ch.Upstream.Where(u => !ch.Archives.Contains(u.Key)))
    {
        <li><a href="@(Site.SafeUrl(up.Url) ?? "#")" rel="nofollow noopener">@a</a> <span class="muted small">· @Site.ArchiveStatus(ch, a)</span></li>
    }
    </ul>
}
