@page "/search"
@using Portal.Channels
@inject Catalogue Catalogue
@inject Search Search
@inject Publishers Publishers
@inject Portal.Accounts.Registry Registry
@{
    var s = SearchQuery.From(Request.Query);
    var hits = Search.Run(s);
    var what = s.Q.Length > 0 ? $"“{s.Q}”" : s.Tag.Length > 0 ? $"tagged {s.Tag}" : null;
    ViewData["Title"] = what is null ? "Packages" : $"Search: {what}";
    var total = Catalogue.Listed().Sum(c => c.Packages.Count);

    // A facet counts what choosing it would give, the other choices kept as they are.
    List<SearchHit> Without(Func<SearchQuery, SearchQuery> clear) => Search.Run(clear(s));
    string Link(SearchQuery q)
    {
        var parts = new List<string>();
        void Add(string k, string v) { if (v.Length > 0) parts.Add($"{k}={Uri.EscapeDataString(v)}"); }
        Add("q", q.Q); Add("arch", q.Arch); Add("kind", q.Kind); Add("category", q.Category);
        Add("channel", q.Channel); Add("tag", q.Tag); Add("sort", q.Sort);
        return "/search" + (parts.Count > 0 ? "?" + string.Join("&", parts) : "");
    }
    var byArch = Without(q => q with { Arch = "" });
    var byKind = Without(q => q with { Kind = "" });
    var byCategory = Without(q => q with { Category = "" });
    var byChannel = Without(q => q with { Channel = "" });
    // Categories by their first part, "util/sys" under "util": a short list to choose from.
    static string Top(string? c) => (c ?? "").Split('/')[0];
    var sortName = s.Sort switch { "newest" => "newest first", "downloads" => "installs", _ => s.Q.Length > 0 ? "relevance" : "name" };
}
<h1 class="sr-only">Packages</h1>
<div class="browse">
    <nav class="facets" aria-label="Filters">
        <h2>CPU</h2>
        <a class="@(s.Arch.Length == 0 ? "on" : "")" href="@Link(s with { Arch = "" })">All <span>@byArch.Count</span></a>
        @foreach (var g in byArch.SelectMany(h => h.Package.Archs.Distinct().Select(a => (a, h))).GroupBy(x => x.a).OrderByDescending(g => g.Count()))
        {
            <a class="@(s.Arch == g.Key ? "on" : "")" href="@Link(s with { Arch = g.Key })">@Site.ArchLabel(g.Key) <span>@g.Count()</span></a>
        }
        <h2>Kind</h2>
        <a class="@(s.Kind.Length == 0 ? "on" : "")" href="@Link(s with { Kind = "" })">All <span>@byKind.Count</span></a>
        @foreach (var g in byKind.GroupBy(h => h.Package.Kind).OrderByDescending(g => g.Count()))
        {
            <a class="@(s.Kind == g.Key ? "on" : "")" href="@Link(s with { Kind = g.Key })">@Site.KindLabel(g.Key) <span>@g.Count()</span></a>
        }
        <h2>Category</h2>
        <a class="@(s.Category.Length == 0 ? "on" : "")" href="@Link(s with { Category = "" })">All <span>@byCategory.Count</span></a>
        @foreach (var g in byCategory.Where(h => Top(h.Package.Latest.Manifest.Category).Length > 0).GroupBy(h => Top(h.Package.Latest.Manifest.Category)).OrderBy(g => g.Key))
        {
            <a class="@(Top(s.Category) == g.Key && s.Category.Length > 0 ? "on" : "")" href="@Link(s with { Category = g.Key })">@g.Key <span>@g.Count()</span></a>
        }
        <h2>Channel</h2>
        <a class="@(s.Channel.Length == 0 ? "on" : "")" href="@Link(s with { Channel = "" })">All <span>@byChannel.Count</span></a>
        @foreach (var g in byChannel.GroupBy(h => h.Package.Channel).OrderByDescending(g => g.Count()))
        {
            <a class="@(s.Channel == g.Key ? "on" : "")" href="@Link(s with { Channel = g.Key })">@g.Key@(Catalogue.IsUnlisted(g.Key) ? " (unlisted)" : "") <span>@g.Count()</span></a>
        }
    </nav>
    <section>
        <div class="listhead">
            <span>@hits.Count of @total.ToString("N0") package@(total == 1 ? "" : "s")@(what is null ? "" : $" for {what}")@if (s.Tag.Length > 0 || s.Q.Length > 0) { <text> · <a href="@Link(s with { Q = "", Tag = "" })">clear</a></text> }</span>
            <span>Sort:
                <a class="@(s.Sort == "" ? "on" : "")" href="@Link(s with { Sort = "" })">@(s.Q.Length > 0 ? "relevance" : "name")</a> ·
                <a class="@(s.Sort == "downloads" ? "on" : "")" href="@Link(s with { Sort = "downloads" })">installs</a> ·
                <a class="@(s.Sort == "newest" ? "on" : "")" href="@Link(s with { Sort = "newest" })">newest</a></span>
        </div>
        @if (hits.Count == 0)
        {
            <div class="guru">
                <p><strong>Software Failure.</strong> Nothing answers that search.</p>
                <p class="muted">Guru Meditation #00000404: try fewer filters, another word, or a library's name such as SDL2.library.</p>
            </div>
        }
        <ul class="rows big">
        @foreach (var h in hits)
        {
            var p = h.Package;
            var key = p.Latest.Signer;
            var who = key is null ? null : Publishers.Find(key);
            <li>
                <span><a class="n" href="/packages/@p.Channel/@p.Name">@p.Name</a><span class="v">@p.Latest.Version</span> <span class="chip">@Site.KindLabel(p.Kind)</span></span>
                <span class="r">@(h.Downloads > 0 ? $"{h.Downloads:N0} install{(h.Downloads == 1 ? "" : "s")}" : Site.Ago(p.Updated))</span>
                <span class="d">@p.Latest.Manifest.Short@if (h.Why is not null) { <span class="muted why"> · @h.Why</span> }</span>
                <span class="meta">
                    @if (key is not null)
                    {
                        <span><a class="@(who?.Name is null ? "key" : "")" href="/publishers/@key">@(who?.Name ?? Site.Short(key))</a>@if (Registry.ByKey(key) is { Suspended: false } v) { <partial name="_Verified" model="v.Login" /> }</span>
                    }
                    <span>@string.Join(" · ", p.Archs.Select(Site.ArchLabel))</span>
                    <span>@p.Channel</span>
                    @if (h.Downloads > 0) { <span>@Site.Ago(p.Updated)</span> }
                </span>
            </li>
        }
        </ul>
        <p class="muted small">The same search for tools and agents: <a href="/api">the JSON API</a>. Names first, then descriptions, tags and the libraries packages provide, then the files they hold.</p>
    </section>
</div>
