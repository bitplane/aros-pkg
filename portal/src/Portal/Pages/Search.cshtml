@page "/search"
@using Portal.Channels
@inject Catalogue Catalogue
@inject Search Search
@{
    var s = SearchQuery.From(Request.Query);
    var hits = Search.Run(s);
    var all = Catalogue.Channels().SelectMany(c => c.Packages.Values).ToList();
    var what = s.Q.Length > 0 ? $"“{s.Q}”" : s.Tag.Length > 0 ? $"tagged {s.Tag}" : s.Category.Length > 0 ? $"in {s.Category}" : null;
    ViewData["Title"] = what is null ? "All packages" : $"Search: {what}";
    var channels = Catalogue.ChannelNames().ToList();
    var categories = all.Select(p => p.Latest.Manifest.Category).OfType<string>().Distinct().Order().ToList();
    var kinds = all.Select(p => p.Kind).Distinct().Order().ToList();
    var archs = all.SelectMany(p => p.Archs).Distinct().Order().ToList();
}
<h1>@(what is null ? "All packages" : $"Packages {(s.Q.Length > 0 ? "matching " : "")}{what}")</h1>
<form class="filters" method="get" action="/search">
    <input type="hidden" name="q" value="@s.Q" />
    @if (s.Tag.Length > 0)
    {
        <input type="hidden" name="tag" value="@s.Tag" />
    }
    <label>Channel
        <select name="channel" data-autosubmit>
            <option value="">any</option>
            @foreach (var c in channels)
            {
                <option value="@c" selected="@(c == s.Channel)">@c</option>
            }
        </select>
    </label>
    <label>Kind
        <select name="kind" data-autosubmit>
            <option value="">any</option>
            @foreach (var k in kinds)
            {
                <option value="@k" selected="@(k == s.Kind)">@Site.KindLabel(k)</option>
            }
        </select>
    </label>
    <label>CPU
        <select name="arch" data-autosubmit>
            <option value="">any</option>
            @foreach (var a in archs)
            {
                <option value="@a" selected="@(a == s.Arch)">@Site.ArchLabel(a)</option>
            }
        </select>
    </label>
    @if (categories.Count > 0)
    {
        <label>Category
            <select name="category" data-autosubmit>
                <option value="">any</option>
                @foreach (var c in categories)
                {
                    <option value="@c" selected="@(c == s.Category)">@c</option>
                }
            </select>
        </label>
    }
    <label>Sort
        <select name="sort" data-autosubmit>
            <option value="" selected="@(s.Sort == "")">relevance</option>
            <option value="newest" selected="@(s.Sort == "newest")">newest</option>
            <option value="downloads" selected="@(s.Sort == "downloads")">downloads</option>
        </select>
    </label>
    <noscript><button type="submit">Filter</button></noscript>
</form>
<p class="muted">@hits.Count result@(hits.Count == 1 ? "" : "s")@(s.Q.Length > 0 ? ": names first, then descriptions, tags and the libraries packages provide, then the files they hold" : "").</p>
@if (hits.Count > 0)
{
    <table class="list">
        <thead><tr><th>Package</th><th>Version</th><th class="hide-s">Kind</th><th class="hide-s">CPU</th><th class="hide-s">Channel</th><th class="num hide-s">Downloads</th></tr></thead>
        <tbody>
        @foreach (var h in hits)
        {
            var p = h.Package;
            <tr>
                <td><a href="/packages/@p.Channel/@p.Name">@p.Name</a>
                    @if (p.Latest.Manifest.Short is { } sh)
                    {
                        <div class="muted small">@sh</div>
                    }
                    @if (h.Why is not null)
                    {
                        <div class="muted small"><em>@h.Why</em></div>
                    }
                </td>
                <td><code>@p.Latest.Version</code></td>
                <td class="hide-s">@Site.KindLabel(p.Kind)</td>
                <td class="hide-s">@string.Join(", ", p.Archs.Select(Site.ArchLabel))</td>
                <td class="hide-s">@p.Channel</td>
                <td class="num hide-s">@(h.Downloads > 0 ? h.Downloads.ToString("N0") : "–")</td>
            </tr>
        }
        </tbody>
    </table>
}
<p class="muted small">The same search for tools and agents: <a href="/api">the JSON API</a>.</p>
