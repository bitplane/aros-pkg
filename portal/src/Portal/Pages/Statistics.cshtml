@page "/statistics"
@using Portal.Channels
@inject Catalogue Catalogue
@inject Downloads Downloads
@inject Usage Usage
@{
    ViewData["Title"] = "Statistics";
    var channels = Catalogue.Listed().ToList();
    var packages = channels.SelectMany(c => c.Packages.Values).ToList();
    var latest = packages.Select(p => p.Latest).ToList();
    var versions = channels.Sum(c => c.Lines.Count);
    var files = latest.Sum(v => v.Manifest.Files.Count);
    var bytes = latest.Sum(v => v.Manifest.InstalledSize);
    var signers = packages.SelectMany(p => p.Versions).Select(v => v.Signer).OfType<string>().Distinct().Count();
    var upstream = channels.SelectMany(c => c.Upstream.Values).DistinctBy(u => u.Sha256).ToList();
    var byKind = latest.GroupBy(v => v.Manifest.Kind).OrderByDescending(g => g.Count()).ToList();
    var byCpu = packages.SelectMany(p => p.Archs).GroupBy(a => a).OrderByDescending(g => g.Count()).ToList();
    var largest = packages.OrderByDescending(p => p.Latest.Manifest.InstalledSize).Take(10).ToList();
    var payloadDownloads = Downloads.All.Where(k => k.Key.StartsWith("payload/")).Sum(k => k.Value);
    var getPkg = Downloads.All.Where(k => k.Key.StartsWith("get/")).OrderByDescending(k => k.Value).ToList();
    // Payload downloads per package: the payload digest of each of its versions.
    long Of(PackageInfo p) => p.Versions.Select(v => v.Manifest.Payload).OfType<string>().Distinct()
        .Sum(d => Downloads.Get($"payload/{p.Channel}/{d}"));
    var mostDownloaded = packages.Select(p => (P: p, N: Of(p))).Where(x => x.N > 0).OrderByDescending(x => x.N).Take(10).ToList();
    int maxKind = byKind.Count > 0 ? byKind.Max(g => g.Count()) : 1;
}
<h1 class="sr-only">Statistics</h1>
<p class="lead">These are totals: what the channels hold, from their signed manifests, and what the portal has served. We do not keep who asked, from where, or anything that could point back to a person: <a href="/privacy">what is kept, and what is not</a>.</p>

<h2 class="label">Catalog</h2>

<div class="stats">
    <div><strong>@packages.Count</strong><span>packages</span></div>
    <div><strong>@versions</strong><span>versions published</span></div>
    <div><strong>@channels.Count</strong><span>channels</span></div>
    <div><strong>@files.ToString("N0")</strong><span>files, latest versions</span></div>
    <div><strong>@Site.Size(bytes)</strong><span>installed, latest versions</span></div>
    <div><strong>@signers</strong><span>publisher key@(signers == 1 ? "" : "s")</span></div>
</div>

<div class="grid">
<section>
    <h2 class="label">By kind</h2>
    <table class="list">
        <tbody>
        @foreach (var g in byKind)
        {
            <tr>
                <td>@Site.KindLabel(g.Key)</td>
                <td class="bar-cell"><span class="track"><span class="bar" style="width:@(100 * g.Count() / maxKind)%"></span></span></td>
                <td class="num">@g.Count()</td>
            </tr>
        }
        </tbody>
    </table>
</section>
<section>
    <h2 class="label">By CPU</h2>
    <table class="list">
        <tbody>
        @foreach (var g in byCpu)
        {
            <tr><td>@Site.ArchLabel(g.Key)</td><td class="bar-cell"><span class="track"><span class="bar" style="width:@(100 * g.Count() / Math.Max(1, byCpu.Max(x => x.Count())))%"></span></span></td><td class="num">@g.Count()</td></tr>
        }
        </tbody>
    </table>
</section>
</div>

@{
    var usage = Usage.All();
    var days = usage.Select(u => u.Day).Distinct().OrderBy(d => d, StringComparer.Ordinal).ToList();
    var lastDays = days.TakeLast(30).ToList();
    long OfDay(string d, string kind) => usage.Where(u => u.Day == d && u.Kind == kind).Sum(u => u.Count);
    long Busiest = lastDays.Count > 0 ? lastDays.Max(d => OfDay(d, Usage.Reads) + OfDay(d, Usage.Downloads)) : 0;
}
@if (usage.Count > 0)
{
    <h2 class="label">pkg in use</h2>
    <p class="muted">Totals only: for each day, how many channel reads, package downloads and pushes came from each pkg version, system and CPU. Those three words are all pkg says about itself, and all the portal keeps: no addresses, no identifiers, no count of people. <a href="/privacy">What is kept, and what is not</a>.</p>
    <div class="stats">
        <div><strong>@usage.Where(u => u.Kind == Usage.Reads).Sum(u => u.Count).ToString("N0")</strong><span>channel reads</span></div>
        <div><strong>@usage.Where(u => u.Kind == Usage.Downloads).Sum(u => u.Count).ToString("N0")</strong><span>packages taken</span></div>
        <div><strong>@usage.Where(u => u.Kind == Usage.Pushes).Sum(u => u.Count).ToString("N0")</strong><span>pushes</span></div>
    </div>
    @if (lastDays.Count > 1)
    {
        <p class="muted small">Reads and downloads a day, @lastDays.Count day@(lastDays.Count == 1 ? "" : "s") to @lastDays[^1].</p>
        <div class="days" role="img" aria-label="Reads and downloads a day">
        @foreach (var d in lastDays)
        {
            var n = OfDay(d, Usage.Reads) + OfDay(d, Usage.Downloads);
            <i style="height:@(Busiest > 0 ? Math.Max(2, 100 * n / Busiest) : 2)%" title="@d: @n.ToString("N0")"></i>
        }
        </div>
        <div class="ends"><span>@lastDays[0]</span><span>@lastDays[^1]</span></div>
    }
    <div class="grid">
    <section>
        <h3 class="label">By version</h3>
        <table class="list">
            <thead><tr><th>pkg</th><th class="hide-s">Systems</th><th class="num">Reads</th><th class="num">Packages</th></tr></thead>
            <tbody>
            @foreach (var g in usage.GroupBy(u => u.Version).OrderByDescending(g => g.Sum(u => u.Count)).Take(12))
            {
                <tr>
                    <td><code>@g.Key</code></td>
                    <td class="hide-s muted small">@string.Join(", ", g.Select(u => u.System).Distinct().Order())</td>
                    <td class="num">@g.Where(u => u.Kind == Usage.Reads).Sum(u => u.Count).ToString("N0")</td>
                    <td class="num">@g.Where(u => u.Kind == Usage.Downloads).Sum(u => u.Count).ToString("N0")</td>
                </tr>
            }
            </tbody>
        </table>
    </section>
    <section>
        <h3 class="label">By system and CPU</h3>
        <table class="list">
            <tbody>
            @{ var bySystem = usage.GroupBy(u => (u.System, u.Cpu)).OrderByDescending(g => g.Sum(u => u.Count)).Take(12).ToList();
               long most = bySystem.Count > 0 ? bySystem.Max(g => g.Sum(u => u.Count)) : 1; }
            @foreach (var g in bySystem)
            {
                var n = g.Sum(u => u.Count);
                <tr>
                    <td>@g.Key.System <span class="muted small">@g.Key.Cpu</span></td>
                    <td class="bar-cell"><span class="track"><span class="bar" style="width:@(100 * n / Math.Max(1, most))%"></span></span></td>
                    <td class="num">@n.ToString("N0")</td>
                </tr>
            }
            </tbody>
        </table>
    </section>
    </div>
}

<h2 class="label">Downloads</h2>
<p class="muted small">Counted here: signed packages the portal serves, and the ways of getting pkg. Not counted: archives such as the nightly contrib build, which come straight from their makers' servers, and manifests, which every pkg reads just to look at a channel.</p>
<div class="stats">
    <div><strong class="@(payloadDownloads == 0 ? "zero" : "")">@payloadDownloads.ToString("N0")</strong><span>package downloads</span></div>
    <div><strong class="@(getPkg.Sum(k => k.Value) == 0 ? "zero" : "")">@getPkg.Sum(k => k.Value).ToString("N0")</strong><span>pkg downloads</span></div>
</div>
@if (getPkg.Count > 0 || mostDownloaded.Count > 0)
{
    <div class="grid">
    <section>
        @if (mostDownloaded.Count > 0)
        {
            <h3 class="label">Most downloaded packages</h3>
            <table class="list">
                <tbody>
                @foreach (var (p, n) in mostDownloaded)
                {
                    <tr><td><a href="/packages/@p.Channel/@p.Name">@p.Name</a></td><td class="num">@n.ToString("N0")</td></tr>
                }
                </tbody>
            </table>
        }
    </section>
    <section>
        @if (getPkg.Count > 0)
        {
            <h3 class="label">pkg, by download</h3>
            <table class="list">
                <tbody>
                @foreach (var k in getPkg)
                {
                    <tr><td><code>@k.Key.Split('/').Last()</code></td><td class="num">@k.Value.ToString("N0")</td></tr>
                }
                </tbody>
            </table>
        }
    </section>
    </div>
}

<h2 class="label">Largest packages</h2>
<table class="list">
    <thead><tr><th>Package</th><th class="hide-s">Channel</th><th class="num">Files</th><th class="num">Installed</th></tr></thead>
    <tbody>
    @foreach (var p in largest)
    {
        <tr>
            <td><a href="/packages/@p.Channel/@p.Name">@p.Name</a></td>
            <td class="hide-s">@p.Channel</td>
            <td class="num">@p.Latest.Manifest.Files.Count.ToString("N0")</td>
            <td class="num">@Site.Size(p.Latest.Manifest.InstalledSize)</td>
        </tr>
    }
    </tbody>
</table>

@if (upstream.Count > 0)
{
    <h2 class="label">Archives kept by their makers</h2>
    <p class="muted small">Packages whose files stay in an archive published elsewhere. The portal holds none of these bytes; pkg downloads each archive once and checks it against the signed manifest.</p>
    <div class="stats">
        <div><strong>@upstream.Count</strong><span>archive@(upstream.Count == 1 ? "" : "s")</span></div>
        <div><strong>@Site.Size(upstream.Sum(u => u.Size))</strong><span>not stored on the portal</span></div>
    </div>
}

<h2 class="label">Channels</h2>
<table class="list">
    <thead><tr><th>Channel</th><th class="num">Packages</th><th class="num">Versions</th><th class="hide-s">Latest build</th><th class="hide-s">Updated</th></tr></thead>
    <tbody>
    @foreach (var c in channels)
    {
        var b = c.Builds().FirstOrDefault();
        <tr>
            <td><a href="/channels/@c.Name">@c.Name</a></td>
            <td class="num">@c.Packages.Count</td>
            <td class="num">@c.Lines.Count</td>
            <td class="hide-s">@(b is null ? "-" : $"{Site.BuildLabel(b.Build)}: {b.Published} published, {b.Unchanged} unchanged")</td>
            <td class="hide-s muted">@Site.Ago(c.Updated)</td>
        </tr>
    }
    </tbody>
</table>
