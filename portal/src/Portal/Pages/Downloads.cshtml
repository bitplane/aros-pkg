@page "/downloads"
@using Microsoft.Extensions.Options
@using Portal.Channels
@inject Catalogue Catalogue
@inject IOptions<PortalOptions> Options
@{
    ViewData["Title"] = "Downloads";
    // Pkg comes from the channel that carries it: "pkg" unless pinned elsewhere.
    var pkgHome = Catalogue.Pinned().FirstOrDefault(p => p.Name == "pkg")?.Channel ?? "pkg";
    var ch = Catalogue.Get(pkgHome);
    var pkg = ch?.Packages.GetValueOrDefault("pkg");
}
<h1 class="sr-only">Downloads</h1>
@if (ch is null || pkg is null)
{
    <p class="muted">Pkg is not published yet.</p>
    return;
}
@{
    var dir = System.IO.Path.Combine(Options.Value.ChannelsDir, ch.Name);
    var site = Options.Value.PublicUrl.Length > 0 ? Options.Value.PublicUrl.TrimEnd('/') : $"{Request.Scheme}://{Request.Host}";
    var cpus = Bootstrap.ArosCpus(dir);
    var hosts = ChannelPaths.HostBootstraps.Where(h => System.IO.File.Exists(System.IO.Path.Combine(dir, h.Value))).ToList();
    (string Eyebrow, string Title, string Text) Host(string platform) => platform switch
    {
        "macos-arm64" => ("macOS", "Pkg for macOS, Apple Silicon", "Point ROOT at your mounted AROS disk, an image or an emulator's folder."),
        "macos-x86_64" => ("macOS", "Pkg for macOS, Intel", "Point ROOT at your mounted AROS disk, an image or an emulator's folder."),
        "linux-x86_64" => ("Linux", "Pkg for Linux x86_64", "One static program, nothing to install beside it."),
        "linux-arm64" => ("Linux", "Pkg for Linux aarch64", "One static program: a Raspberry Pi runs it too."),
        _ => ("Windows", "Pkg for Windows", "A single pkg.exe, no installer."),
    };
    var upgrade = $"pkg UPGRADE ALL ROOT SYS: CHANNEL {site}/{ch.Name}";
}
<p class="lead">The Pkg client, version @pkg.Latest.Version. Run it on AROS itself, or on another machine that can see your AROS disk. It installs everything else on this site.</p>
<div class="cards">
    @foreach (var cpu in cpus)
    {
        <div class="card">
            <span class="eyebrow">AROS</span>
            <span class="card-title">Pkg for AROS @cpu</span>
            <span class="muted">A small drawer that installs Pkg as a signed package: unpack it, then run its Install-Pkg.</span>
            <span class="foot-row"><span>@Site.Size(Bootstrap.Offer(dir, $"Bootstrap/{cpu}/Pkg").Size) · .zip</span><a class="button outline" href="/get/@ch.Name/pkg-@(cpu).zip">Download</a></span>
        </div>
    }
    @foreach (var (platform, rel) in hosts)
    {
        var h = Host(platform);
        <div class="card">
            <span class="eyebrow">@h.Eyebrow</span>
            <span class="card-title">@h.Title</span>
            <span class="muted">@h.Text</span>
            <span class="foot-row"><span>@Site.Size(Bootstrap.Offer(dir, rel).Size)</span><a class="button outline" href="/get/@ch.Name/@platform">Download</a></span>
        </div>
    }
</div>

<h2 class="label">@(cpus.Count + hosts.Count > 0 ? "Or let it install itself" : "Get Pkg")</h2>
<partial name="_GetPkg" model="ch" />

<h2 class="label">Then</h2>
<div class="cmd"><code>@upgrade</code><button class="copy" data-copy="@upgrade">Copy</button></div>
<p class="muted">This keeps everything you installed current, Pkg included. Taking something out again: <a href="/docs/removing">Removing software</a>.</p>
<p class="muted">Every download is signed like a package. The checksums and the signer's key are on the <a href="/trust">Trust</a> page.</p>

<h2 class="label">Channels</h2>
<p>A channel is an address Pkg reads packages from. Give it to <code>CHANNEL</code>.</p>
<table class="list">
    <thead><tr><th>Channel</th><th>Address</th><th class="num">Packages</th></tr></thead>
    <tbody>
    @foreach (var c in Catalogue.Listed())
    {
        var url = Site.ChannelUrl(Request, Options.Value, c.Name);
        <tr>
            <td><a href="/channels/@c.Name">@c.Name</a></td>
            <td><code>@url</code> <button class="copy" data-copy="@url">Copy</button></td>
            <td class="num">@c.Packages.Count</td>
        </tr>
    }
    </tbody>
</table>
<p class="muted">Want your software here? <a href="/publishers#publish">Publish on this portal</a> says how to ask.</p>
