<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.S3" Version="4.0.103.3" />
    <PackageReference Include="Markdig" Version="1.3.2" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Install/install.sh;Install/install.ps1;Install/Get-Pkg" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- The verifier that needs no Pkg, served at /verify-manifest.py for /trust. -->
    <Content Include="../../../tools/verify-manifest.py" Link="Install/verify-manifest.py" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The user guides of this repository, rendered by /docs: the site's
       documentation always matches the Pkg built from the same commit. -->
  <ItemGroup>
    <Content Include="../../../README.md" Link="userdocs/README.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- Only what the README's Guides list links is shown; contributors' pages are not bundled at all. -->
    <Content Include="../../../docs/**/*.md" Exclude="../../../docs/README.md;../../../docs/development*.md;../../../docs/container.md;../../../docs/aros-defects.md;../../../docs/history.md" LinkBase="userdocs" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The footer says which portal this is: build number (commits), commit, build time. -->
  <PropertyGroup><Version>1.0.0</Version></PropertyGroup>
  <Target Name="StampBuild" BeforeTargets="GetAssemblyAttributes">
    <Exec Command="git rev-parse --short HEAD" ConsoleToMSBuild="true" ContinueOnError="true" StandardOutputImportance="low" IgnoreExitCode="true"><Output TaskParameter="ConsoleOutput" PropertyName="GitCommit" /></Exec>
    <Exec Command="git rev-list --count HEAD" ConsoleToMSBuild="true" ContinueOnError="true" StandardOutputImportance="low" IgnoreExitCode="true"><Output TaskParameter="ConsoleOutput" PropertyName="GitCount" /></Exec>
    <ItemGroup>
      <AssemblyMetadata Include="Commit" Value="$(GitCommit)" />
      <AssemblyMetadata Include="Build" Value="$(GitCount)" />
      <AssemblyMetadata Include="Built" Value="$([System.DateTime]::UtcNow.ToString('yyyy-MM-dd HH:mm'))" />
    </ItemGroup>
  </Target>
</Project>
